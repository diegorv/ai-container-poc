{
  "name": "mydevc",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Clean TypeScript reimplementation of the trail-of-bits claude-code-devcontainer fork",
  "bin": {
    "mydevc": "./dist/cli/index.js",
    "mydevc-init": "./dist/container-init/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "node scripts/build.mjs",
    "test": "vitest",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@devcontainers/cli": "^0.87.0",
    "execa": "^9.5.2",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=25"
  },
  "packageManager": "pnpm@11.7.0"
}
