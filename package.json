{
  "name": "mydevc",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Clean TypeScript reimplementation of the trail-of-bits claude-code-devcontainer fork",
  "bin": {
    "mydevc": "./dist/cli/index.js",
    "mydevc-init": "./dist/container-init/index.js"
  },
  "files": ["dist", "templates"],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup",
    "test": "vitest",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@devcontainers/cli": "^0.80.0",
    "execa": "^9.5.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.9",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.2"
}
