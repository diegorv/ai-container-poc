# >>> harden-npm-project (managed) >>>
# npm supply-chain hardening — mirrors the machine ~/.npmrc so CI and teammates
# inherit it. Ref: github.com/lirantal/npm-security-best-practices
ignore-scripts=true
# Dependency-confusion guard (rule 27): pin your private scope to its registry
# so a same-named public package cannot shadow it.
# @your-scope:registry=https://your-registry.example.com
# //your-registry.example.com/:_authToken=${NPM_TOKEN}
# <<< harden-npm-project (managed) <<<
